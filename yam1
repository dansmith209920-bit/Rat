          cat > app/src/main/java/ai/venice/rat/caps/CameraStreamer.kt <<'EOF'
          package ai.venice.rat.caps
          import android.content.Context
          import android.graphics.Bitmap
          import android.graphics.Matrix
          import android.os.Handler
          import android.os.Looper
          import android.os.SystemClock
          import android.util.Log
          import android.util.Size
          import androidx.camera.core.*
          import androidx.camera.lifecycle.ProcessCameraProvider
          import androidx.core.content.ContextCompat
          import androidx.lifecycle.Lifecycle
          import androidx.lifecycle.LifecycleOwner
          import androidx.lifecycle.LifecycleRegistry
          import java.io.ByteArrayOutputStream
          import java.util.concurrent.Executors
          class CameraStreamer(private val ctx: Context) : LifecycleOwner {
            private val reg = LifecycleRegistry(this)
            private val main = Handler(Looper.getMainLooper())
            private val ex = Executors.newSingleThreadExecutor()
            private var provider: ProcessCameraProvider? = null
            override val lifecycle: Lifecycle get() = reg
            @Volatile var facing = CameraSelector.LENS_FACING_BACK
            @Volatile var fps = 8
            @Volatile var quality = 55
            @Volatile var active = false; private set
            @Volatile private var shot = false
            private var last = 0L
            var onFrame: ((ByteArray) -> Unit)? = null
            fun start() = main.post {
              if (active) return@post
              active = true
              reg.handleLifecycleEvent(Lifecycle.Event.ON_CREATE)
              reg.handleLifecycleEvent(Lifecycle.Event.ON_START)
              reg.handleLifecycleEvent(Lifecycle.Event.ON_RESUME); bind()
            }
            fun stop() = main.post {
              if (!active) return@post
              active = false; provider?.unbindAll()
              reg.handleLifecycleEvent(Lifecycle.Event.ON_PAUSE)
              reg.handleLifecycleEvent(Lifecycle.Event.ON_STOP)
              reg.handleLifecycleEvent(Lifecycle.Event.ON_DESTROY)
            }
            fun switch() = main.post {
              facing = if (facing == CameraSelector.LENS_FACING_BACK) CameraSelector.LENS_FACING_FRONT else CameraSelector.LENS_FACING_BACK
              if (active) bind()
            }
            fun shot() { shot = true }
            private fun bind() {
              val f = ProcessCameraProvider.getInstance(ctx)
              f.addListener({ runCatching {
                val p = f.get(); provider = p; p.unbindAll()
                val a = ImageAnalysis.Builder()
                  .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                  .setResolutionSelector(ResolutionSelector.Builder().setResolutionStrategy(
                    ResolutionStrategy(Size(640, 480), ResolutionStrategy.FALLBACK_RULE_CLOSEST_LOWER_THEN_HIGHER)).build())
                  .build()
                a.setAnalyzer(ex) { emit(it) }
                p.bindToLifecycle(this, CameraSelector.Builder().requireLensFacing(facing).build(), a)
              }.onFailure { Log.w("CAM", "bind", it) } }, ContextCompat.getMainExecutor(ctx))
            }
            private fun emit(px: ImageProxy) {
              try {
                val s = shot; val now = SystemClock.elapsedRealtime()
                if (!s && now - last < 1000L / fps) return
                last = now; if (s) shot = false
                var b: Bitmap = px.toBitmap()
                val d = px.imageInfo.rotationDegrees
                if (d != 0) b = Bitmap.createBitmap(b, 0, 0, b.width, b.height, Matrix().apply { postRotate(d.toFloat()) }, true)
                val o = ByteArrayOutputStream(); b.compress(Bitmap.CompressFormat.JPEG, if (s) 92 else quality, o); b.recycle()
                onFrame?.invoke(o.toByteArray())
              } catch (t: Throwable) { Log.w("CAM", "frame", t) } finally { px.close() }
            }
          }
          EOF

